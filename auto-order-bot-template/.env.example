# ==============================================================================
# TELEGRAM AUTO-ORDER BOT TEMPLATE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan dengan kredensial Anda:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. BOT TELEGRAM
# ------------------------------------------------------------------------------
# Token bot resmi dari @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Username bot tanpa simbol @ (contoh: my_store_bot)
TELEGRAM_BOT_USERNAME="my_store_bot"

# ID Telegram Pemilik / Admin Utama (Dapatkan via @userinfobot di Telegram)
# Pisahkan dengan koma jika memiliki lebih dari 1 admin: 7133868769,123456789
ADMIN_TELEGRAM_IDS="7133868769"

# ------------------------------------------------------------------------------
# 2. DATABASE POSTGRESQL
# ------------------------------------------------------------------------------
# URL koneksi database PostgreSQL (bisa lokal, Supabase, Neon, Railway, dll)
DATABASE_URL="postgresql://postgres:password@localhost:5432/auto_order_bot?sslmode=disable"

# Kunci rahasia untuk enkripsi lisensi/kredensial akun di database (AES-256)
# Buat string acak 32 karakter atau lebih
ENCRYPTION_SECRET="change-this-to-a-very-secure-random-secret-key-32chars"

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY (PILIHAN)
# ------------------------------------------------------------------------------
# Pilihan gateway utama: "shopeepay" | "sakurupiah" | "midtrans" | "manual"
DEFAULT_PAYMENT_GATEWAY="shopeepay"

# --- SHOPEEPAY GATEWAY (https://shopee.prastyaaneki.biz.id) ---
SHOPEEPAY_API_KEY="your_shopeepay_api_key_here"
SHOPEEPAY_API_URL="https://shopee.prastyaaneki.biz.id"
SHOPEEPAY_STATIC_QRIS="00020101021126610016ID.CO.SHOPEE.WWW01189360091800239501700208239501700303UMI51440014ID.CO.QRIS.WWW0215ID10266191349880303UMI5204481453033605802ID5910Dafung Hub6008KARAWANG61054137362070703A016304BBC9"

# --- SAKURUPIAH GATEWAY (https://sakurupiah.id) ---
SAKURUPIAH_API_ID="SANBOX-xxxxxxxx"
SAKURUPIAH_API_KEY="SANBOX-xxxxxxxxxxxxxxxxxxxx"
# Mode: "sandbox" atau "production"
SAKURUPIAH_MODE="sandbox"

# --- MIDTRANS GATEWAY (https://midtrans.com) ---
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# ------------------------------------------------------------------------------
# 4. SUPPLIER H2H API (OPSIONAL / JIKA PAKAI SUPPLIER OTOMATIS)
# ------------------------------------------------------------------------------
# Biarkan kosong jika ingin menggunakan katalog database internal saja
SUPPLIER_BASE_URL="https://api.supplier-kamu.com"
SUPPLIER_API_KEY="api_key_supplier_kamu"

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME & WEBHOOK
# ------------------------------------------------------------------------------
# Port HTTP server (untuk menerima webhook notifikasi pembayaran & status check)
PORT=3000

# Mode koneksi Telegram: "polling" (mudah untuk lokal/dev) atau "webhook" (untuk VPS/hosting dengan HTTPS)
BOT_CONNECTION_MODE="polling"

# Domain publik HTTPS server kamu (wajib jika mode webhook, misal: https://bot.tokokamu.com)
WEBHOOK_URL="https://bot.tokokamu.com"
