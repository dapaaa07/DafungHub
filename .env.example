# Database PostgreSQL Connection URL (Supabase Transaction Pooler port 6543 recommended)
DATABASE_URL=postgresql://postgres:password@localhost:6543/dafung_hub

# Server Runtime (cPanel LiteSpeed reverse proxy port)
PORT=3088
HOSTNAME=127.0.0.1

# Web Application URLs
APP_URL=https://store.dafung.web.id
NEXT_PUBLIC_APP_URL=https://store.dafung.web.id

# Security, Auth & Encryption Secrets (generate with: openssl rand -hex 32)
AES_SECRET_KEY=your_super_secret_aes_key_minimum_32_chars
SESSION_SECRET=your_dedicated_jwt_session_secret_minimum_32_chars
ADMIN_API_KEY=your_strong_admin_api_key_for_admin_mobile_apk
CRON_SECRET=your_random_cron_secret_for_check_payments

# Telegram Bot & Webhook Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_random_telegram_webhook_secret_token
ADMIN_GROUP_CHAT_ID=-1001234567890
ADMIN_TELEGRAM_ID=7133868769

# Supplier API Configuration
SUPPLIER_API_URL=https://api.prastyaaneki.biz.id
SUPPLIER_API_KEY=your_supplier_api_key_here

# Payment Gateway Configuration ('shopeepay' | 'midtrans' | 'sakurupiah')
PAYMENT_GATEWAY=shopeepay

# ShopeePay API Gateway
SHOPEEPAY_API_URL=https://shopee.prastyaaneki.biz.id
SHOPEEPAY_API_KEY=your_shopeepay_api_key_here
SHOPEEPAY_STATIC_QRIS=your_shopeepay_static_qris_here
SHOPEEPAY_WEBHOOK_SECRET=your_shopeepay_webhook_secret_from_dashboard

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxx

# Sakurupiah Payment Gateway
SAKURUPIAH_API_ID=your_sakurupiah_api_id
SAKURUPIAH_API_KEY=your_sakurupiah_api_key

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://store.dafung.web.id/api/auth/google/callback

# Optional: Firebase Service Account JSON (for Admin Mobile APK push notifications)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
