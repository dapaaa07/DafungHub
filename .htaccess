# DaFung Hub - cPanel Apache & Node.js Passenger Configuration

# Disable LiteSpeed Cache completely so Next.js pages are never stale
<IfModule LiteSpeed>
  CacheLookup off
  CacheDisable public /
  CacheDisable private /
</IfModule>

<IfModule mod_headers.c>
  Header always set X-LiteSpeed-Cache-Control "no-cache, no-store"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Allow static files directly
  RewriteCond %{REQUEST_URI} ^/_next/static/(.*)$ [OR]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
</IfModule>
