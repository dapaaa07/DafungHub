# DaFung Hub - cPanel LiteSpeed Reverse Proxy, Security & Error Handling Configuration

# Disable directory listing
Options -Indexes

# Disable LiteSpeed Cache so dynamic Next.js pages are never stale
<IfModule LiteSpeed>
  CacheLookup off
  CacheDisable public /
  CacheDisable private /
</IfModule>

<IfModule mod_headers.c>
  Header always set X-LiteSpeed-Cache-Control "no-cache, no-store"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom static error pages (served directly by LiteSpeed even when Node.js/PM2 is offline)
ErrorDocument 400 /public/errors/400.html
ErrorDocument 401 /public/errors/401.html
ErrorDocument 402 /public/errors/402.html
ErrorDocument 403 /public/errors/403.html
ErrorDocument 404 /public/errors/404.html
ErrorDocument 405 /public/errors/405.html
ErrorDocument 408 /public/errors/408.html
ErrorDocument 429 /public/errors/429.html
ErrorDocument 500 /public/errors/500.html
ErrorDocument 502 /public/errors/502.html
ErrorDocument 503 /public/errors/503.html
ErrorDocument 504 /public/errors/504.html

RewriteEngine On

# Serve custom static error pages directly from disk (never proxy to Node.js)
RewriteCond %{REQUEST_URI} ^/public/errors/[0-9]{3}\.html$ [OR]
RewriteCond %{REQUEST_URI} ^/public/503\.html$
RewriteRule ^ - [L]

# Allow cPanel AutoSSL / ACME challenge verification
RewriteCond %{REQUEST_URI} ^/\.well-known/
RewriteRule ^ - [L]

# SECURITY: Explicitly deny direct web access to dotfiles (.env, .git, .cache, .htaccess),
# server source directories, configs, backups, and credentials on disk
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(app|bot|components|lib|migrations|node_modules|scripts|tests|dist|dafung-web|dafung-hub-admin)(/|$) - [F,L]
RewriteRule ^(server\.js|ecosystem\.config\.cjs|next\.config\.ts|package(-lock)?\.json|tsconfig\.json|README.*\.md)$ - [F,L]
RewriteRule \.(env|bak|sql|log|zip|tar|gz|ts|tsx|cjs|mjs|pem|key)$ - [F,L]

# Reverse proxy all application routes cleanly to local PM2 Next.js server (port 3088)
RewriteRule ^$ http://127.0.0.1:3088/ [P,L]
RewriteRule ^(.*)$ http://127.0.0.1:3088/$1 [P,L]
