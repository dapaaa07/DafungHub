# DaFung Hub - cPanel Apache & Node.js Passenger Configuration

# Disable LiteSpeed Cache completely so Next.js pages are never stale
<IfModule LiteSpeed>
  CacheLookup off
  CacheDisable public /
  CacheDisable private /
</IfModule>

<IfModule mod_headers.c>
  Header always set X-LiteSpeed-Cache-Control "no-cache, no-store"
</IfModule>

# Custom static error pages (served directly by LiteSpeed even when Node.js/PM2 is offline)
ErrorDocument 500 /public/503.html
ErrorDocument 502 /public/503.html
ErrorDocument 503 /public/503.html
ErrorDocument 504 /public/503.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Allow static files & custom error page directly
  RewriteCond %{REQUEST_URI} ^/_next/static/(.*)$ [OR]
  RewriteCond %{REQUEST_URI} ^/public/503\.html$ [OR]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
</IfModule>
