{
  "name": "dafung-hub",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:bot": "esbuild scripts/run-bot.ts --bundle --platform=node --target=node18 --outfile=dist/bot.js --external:pg-native --external:node-telegram-bot-api || true",
    "start": "next start",
    "start:bot": "node dist/bot.js",
    "start:dev": "tsx scripts/run-bot.ts",
    "lint": "eslint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "bot": "tsx scripts/run-bot.ts",
    "web:dev": "npm --prefix dafung-web run dev",
    "web:build": "npm --prefix dafung-web run build",
    "web:start": "npm --prefix dafung-web run start"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "crypto-js": "^4.2.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.55.0",
    "midtrans-client": "^1.4.3",
    "next": "16.4.0",
    "node-telegram-bot-api": "^2.1.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/crypto-js": "^4.2.2",
    "@types/midtrans-client": "^1.4.0",
    "@types/node": "^20",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4"
  }
}
