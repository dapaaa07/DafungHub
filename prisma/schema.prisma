// Prisma Schema Definition for dafung-hub

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  buyer
  admin

  @@map("user_role")
}

enum PaymentStatus {
  unpaid
  paid
  expired

  @@map("payment_status")
}

enum FulfillmentStatus {
  pending
  processing
  delivered

  @@map("fulfillment_status")
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegramId  String   @unique @map("telegram_id") @db.VarChar(255)
  role        UserRole @default(buyer)
  balance     Int      @default(0)
  username               String?   @db.VarChar(255)
  firstName              String?   @map("first_name") @db.VarChar(255)
  membershipTier         String    @default("free") @map("membership_tier") @db.VarChar(50)
  membershipExpiresAt    DateTime? @map("membership_expires_at") @db.Timestamptz(6)
  weeklyDiscountUsed     Int       @default(0) @map("weekly_discount_used")
  weeklyDiscountResetAt  DateTime? @map("weekly_discount_reset_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  orders         Order[]
  voucherUsages  VoucherUsage[]

  @@index([telegramId])
  @@map("users")
}

model Product {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(255)
  price      Int
  stock      Int      @default(0)
  categoryId String?  @map("category_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders     Order[]

  @@index([isActive])
  @@map("products")
}

model Order {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  productId           String            @map("product_id") @db.Uuid
  orderCode           String            @unique @map("order_code") @db.VarChar(100)
  paymentStatus       PaymentStatus     @default(unpaid) @map("payment_status")
  fulfillmentStatus   FulfillmentStatus @default(pending) @map("fulfillment_status")
  invoiceData         Json              @default("{}") @map("invoice_data")
  credentialEncrypted String?           @map("credential_encrypted")
  deliveredAt         DateTime?         @map("delivered_at") @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  voucherUsages       VoucherUsage[]

  @@index([userId])
  @@index([orderCode])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@map("orders")
}

model Voucher {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String         @unique @db.VarChar(50)
  type            String         @db.VarChar(50)
  discountType    String         @default("nominal") @map("discount_type") @db.VarChar(20)
  discountValue   Int            @map("discount_value")
  productTarget   String?        @map("product_target") @db.VarChar(255)
  minOrderAmount  Int            @default(0) @map("min_order_amount")
  maxUses         Int            @default(10) @map("max_uses")
  usedCount       Int            @default(0) @map("used_count")
  isActive        Boolean        @default(true) @map("is_active")
  expiresAt       DateTime?      @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  usages          VoucherUsage[]

  @@index([code])
  @@index([isActive])
  @@map("vouchers")
}

model VoucherUsage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId      String    @map("voucher_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  orderId        String?   @map("order_id") @db.Uuid
  discountAmount Int       @default(0) @map("discount_amount")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  voucher        Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([voucherId, userId], name: "uq_voucher_user")
  @@index([userId])
  @@map("voucher_usages")
}
