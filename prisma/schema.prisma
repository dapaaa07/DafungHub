// Prisma Schema Definition for dafung-hub

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  buyer
  admin

  @@map("user_role")
}

enum PaymentStatus {
  unpaid
  paid
  expired

  @@map("payment_status")
}

enum FulfillmentStatus {
  pending
  processing
  delivered

  @@map("fulfillment_status")
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegramId  String   @unique @map("telegram_id") @db.VarChar(255)
  role        UserRole @default(buyer)
  balance     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orders      Order[]

  @@index([telegramId])
  @@map("users")
}

model Product {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(255)
  price      Int
  stock      Int      @default(0)
  categoryId String?  @map("category_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders     Order[]

  @@index([isActive])
  @@map("products")
}

model Order {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  productId           String            @map("product_id") @db.Uuid
  orderCode           String            @unique @map("order_code") @db.VarChar(100)
  paymentStatus       PaymentStatus     @default(unpaid) @map("payment_status")
  fulfillmentStatus   FulfillmentStatus @default(pending) @map("fulfillment_status")
  invoiceData         Json              @default("{}") @map("invoice_data")
  credentialEncrypted String?           @map("credential_encrypted")
  deliveredAt         DateTime?         @map("delivered_at") @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([orderCode])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@map("orders")
}
